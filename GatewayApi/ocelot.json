      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5130 } ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "UpstreamPathTemplate": "/gateway/mascotas{everything}",
      "UpstreamHttpMethod": [ "Get" ],
